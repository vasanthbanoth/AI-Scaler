# ═══════════════════════════════════════════════════════════
# SERVER-ONLY — never commit .env or expose in client code
# ═══════════════════════════════════════════════════════════

# OpenAI (chat LLM + embeddings ingest)
OPENAI_API_KEY=

# Groq — free tier fallback LLM (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings: auto | openai | local (local = free BGE model, no OpenAI billing)
EMBEDDING_PROVIDER=local

# FastAPI backend URL (Render). Vercel sets this for Next.js API routes.
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Cal.com — real calendar booking
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_USERNAME=vasanthbanoth

# Voice — Vapi dashboard
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_SERVER_SECRET=

# Public only (safe for browser) — voice number shown on landing
NEXT_PUBLIC_VOICE_PHONE=

# GitHub corpus ingest
GITHUB_USERNAME=vasanthbanoth
GITHUB_TOKEN=

# Render first-boot ingest
RUN_INGEST_ON_START=1
REPO_ROOT=

# Local dev only — set 1 to test without OpenAI (NOT for submission)
DEMO_MODE=0
