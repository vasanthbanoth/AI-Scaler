# ─── LLM (required for chat + voice tool routing) ───
OPENAI_API_KEY=

# ─── Public URLs (set after deploy) ───
# Chat lives at {API_BASE_URL}/chat (single deploy — no Vercel required)
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:8000/chat

# Auto-build corpus on first Render boot (needs OPENAI_API_KEY in dashboard)
RUN_INGEST_ON_START=1

# ─── Calendar — Cal.com (recommended) ───
# Create event type at cal.com → Settings → Developer → API keys
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_USERNAME=vasanthbanoth

# Alternative: Google Calendar (optional, leave blank if using Cal.com)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

# ─── Voice — Vapi (https://dashboard.vapi.ai) ───
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# Webhook secret for /voice/vapi webhook verification
VAPI_SERVER_SECRET=change-me-to-random-string

# ─── GitHub corpus (public repos only; increase if you have more) ───
GITHUB_USERNAME=vasanthbanoth
GITHUB_TOKEN=

# ─── Optional observability ───
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
